{
  "version": 1,
  "cases": [
    {
      "name": "short_values",
      "description": "The issue's 4,000 rows of three short strings must fit the whole-input budget.",
      "source": [
        "https://github.com/nwverse/persona/issues/2907 item 2",
        "server/internal/transcript/clip.go: clipJSON",
        "integrations/runtime-sdk/lib/items.js: clipInput"
      ],
      "input": {
        "values": {
          "$repeat": 4000,
          "value": [
            { "$index": 0 },
            { "$string": "a", "count": 17 },
            { "$string": "b", "count": 18 }
          ]
        }
      },
      "expected": {
        "check": "short_values",
        "input_bytes": 198902,
        "output_bytes": 24560,
        "remaining": 501,
        "array_items": 3499,
        "object_fields": 0,
        "marker": true
      }
    },
    {
      "name": "nested_arrays",
      "description": "Both outer rows and their retained nested arrays are shortened without processing detached arrays.",
      "source": [
        "server/internal/transcript/clip_bound.go: boundInputJSON",
        "integrations/runtime-sdk/lib/input-clip.js: boundInput"
      ],
      "input": {
        "outer": {
          "$repeat": 200,
          "value": { "$repeat": 100, "value": "x" }
        }
      },
      "expected": {
        "check": "nested_arrays",
        "marker": true
      }
    },
    {
      "name": "object_array",
      "description": "A MultiEdit array loses only whole tail objects and keeps every retained edit's field types.",
      "source": [
        "web/src/views/chat/ActionRow.tsx: editDiffs",
        "apple/Persona/Views/Chat/ToolViews.swift: ToolDetail",
        "android/feature/chat/src/main/kotlin/persona/feature/chat/ContentPresentation.kt: editInput"
      ],
      "input": {
        "file_path": "/home/user/project/a.go",
        "edits": {
          "$repeat": 2000,
          "value": { "old_string": "a", "new_string": "b" }
        }
      },
      "expected": {
        "check": "object_array",
        "marker": true
      }
    },
    {
      "name": "todo_array",
      "description": "A TodoWrite list loses only whole tail objects, leaving every retained to-do decodable.",
      "source": [
        "server/internal/transcript/fold_tasks.go: foldTaskSnapshots",
        "web/src/lib/work-groups.ts: planTodos",
        "apple/Persona/Views/Chat/ChatPlan.swift: todos",
        "android/core/domain/src/main/kotlin/persona/core/domain/lines/TaskProgress.kt: rebuildTaskProgress"
      ],
      "input": {
        "todos": {
          "$repeat": 2000,
          "value": { "content": "Do the work", "activeForm": "Doing the work", "status": "pending" }
        }
      },
      "expected": {
        "check": "todo_array",
        "marker": true
      }
    },
    {
      "name": "question_array",
      "description": "A question list and its retained options keep their object shapes and value types.",
      "source": [
        "web/src/lib/tool-detail.ts: toolQuestions",
        "apple/Persona/Views/Chat/ToolViews.swift: AskUserDetail",
        "android/feature/chat/src/main/kotlin/persona/feature/chat/ToolDetails.kt: toolQuestions"
      ],
      "input": {
        "questions": {
          "$repeat": 1000,
          "value": {
            "question": "Choose one?",
            "header": "Choice",
            "options": [{ "label": "A", "description": "First" }],
            "multi_select": false
          }
        }
      },
      "expected": {
        "check": "question_array",
        "marker": true
      }
    },
    {
      "name": "wide_object",
      "description": "After the only nonempty array is empty, trailing fields of the widest object are omitted.",
      "source": [
        "server/internal/transcript/clip_bound.go: boundInputJSON",
        "integrations/runtime-sdk/lib/input-clip.js: boundInput"
      ],
      "input": {
        "values": { "$repeat": 100, "value": "short" },
        "wide": {
          "$fields": 2000,
          "key": "a_long_field_name_with_many_bytes_",
          "pad": 4,
          "value": { "$index": 0 }
        }
      },
      "expected": {
        "check": "wide_object",
        "marker": true
      }
    },
    {
      "name": "root_wide_object",
      "description": "When the root itself is widest, trailing fields go but the fixed marker remains.",
      "source": [
        "server/internal/transcript/clip_bound.go: dropInputClipTail",
        "integrations/runtime-sdk/lib/input-clip.js: dropInputClipTail"
      ],
      "input": {
        "$fields": 2000,
        "key": "root_field_",
        "pad": 4,
        "value": { "$index": 0 }
      },
      "expected": {
        "check": "root_wide",
        "key_prefix": "root_field_",
        "marker": true
      }
    },
    {
      "name": "escaped_root_object",
      "description": "Escaped keys and values are counted with each implementation's own JSON encoder.",
      "source": [
        "server/internal/transcript/clip.go: marshalPlain",
        "integrations/runtime-sdk/lib/items.js: jsonLen"
      ],
      "input": {
        "$fields": 2000,
        "key": "quote_\"_slash_\\_control_\u0001_<>&_",
        "pad": 4,
        "value": "quote_\"_slash_\\_control_\u0001_<>&_  "
      },
      "expected": {
        "check": "root_wide",
        "key_prefix": "quote_\"_slash_\\_control_\u0001_<>&_",
        "value": "quote_\"_slash_\\_control_\u0001_<>&_  ",
        "marker": true
      }
    },
    {
      "name": "single_long_key",
      "description": "One oversized root key is removed without removing the marker itself.",
      "source": [
        "server/internal/transcript/clip_bound.go: dropInputClipTail",
        "integrations/runtime-sdk/lib/input-clip.js: dropInputClipTail"
      ],
      "input": {
        "$single_field": { "$string": "k", "count": 25000 },
        "value": "short"
      },
      "expected": {
        "check": "single_long_key",
        "array_items": 0,
        "object_fields": 1,
        "marker": true
      }
    },
    {
      "name": "mixed_strings",
      "description": "The two string passes run before many short array values are omitted.",
      "source": [
        "server/internal/transcript/clip.go: clipJSON",
        "integrations/runtime-sdk/lib/items.js: clipInput"
      ],
      "input": {
        "long": { "$string": "abcdef", "count": 1000 },
        "values": {
          "$repeat": 3000,
          "value": ["short", { "$index": 0 }, true, null]
        }
      },
      "expected": {
        "check": "mixed_strings",
        "marker": true
      }
    },
    {
      "name": "one_byte_over",
      "description": "An object exactly one byte over the budget pays for both its omissions and their marker.",
      "source": [
        "server/internal/transcript/clip_bound.go: boundInputJSON",
        "integrations/runtime-sdk/lib/input-clip.js: boundInput"
      ],
      "input": {
        "$pad_object_to": 24577,
        "value": {
          "values": { "$repeat": 2430, "value": "1234567" }
        }
      },
      "expected": {
        "check": "one_byte_over",
        "input_bytes": 24577,
        "output_bytes": 24573,
        "remaining": 2419,
        "array_items": 11,
        "object_fields": 0,
        "marker": true
      }
    },
    {
      "name": "exact_budget",
      "description": "A boundary fixture finishes at exactly the budget so an unaccounted marker byte fails.",
      "source": [
        "server/internal/transcript/clip_bound.go: boundInputJSON",
        "integrations/runtime-sdk/lib/input-clip.js: boundInput"
      ],
      "input": {
        "$pad_object_to": 24580,
        "value": {
          "values": { "$repeat": 2430, "value": "1234567" }
        }
      },
      "expected": {
        "check": "one_byte_over",
        "input_bytes": 24580,
        "output_bytes": 24576,
        "remaining": 2419,
        "array_items": 11,
        "object_fields": 0,
        "marker": true
      }
    },
    {
      "name": "at_budget",
      "description": "An input already at the budget is returned without structural clipping or a marker.",
      "source": [
        "server/internal/transcript/clip.go: clipJSON",
        "integrations/runtime-sdk/lib/items.js: clipInput"
      ],
      "input": {
        "$pad_object_to": 24576,
        "value": {
          "values": { "$repeat": 2430, "value": "1234567" }
        }
      },
      "expected": {
        "check": "unchanged",
        "input_bytes": 24576,
        "output_bytes": 24576,
        "marker": false
      }
    },
    {
      "name": "marker_collision",
      "description": "An existing marker-like user field is preserved and the synthetic marker gets a deterministic suffix.",
      "source": [
        "server/internal/transcript/clip_bound.go: boundInputJSON",
        "integrations/runtime-sdk/lib/input-clip.js: boundInput"
      ],
      "input": {
        "zz_persona_clipped": "keep this user value",
        "zz_persona_clipped_2": "keep this second user value",
        "values": {
          "$repeat": 4000,
          "value": [
            { "$index": 0 },
            { "$string": "a", "count": 17 },
            { "$string": "b", "count": 18 }
          ]
        }
      },
      "expected": {
        "check": "marker_collision",
        "marker": true,
        "marker_key": "zz_persona_clipped_3"
      }
    }
  ]
}
