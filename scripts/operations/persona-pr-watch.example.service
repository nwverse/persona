[Unit]
Description=Persona maintainer PR review watcher
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/persona/scripts/operations
Environment=PR_WATCH_CONFIG=%h/.config/persona/pr-watch.json
EnvironmentFile=-%h/.config/persona/pr-watch.env
ExecStart=/usr/bin/python3 -I /opt/persona/scripts/operations/pr_watch.py
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
