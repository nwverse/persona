{
  "id": "tabletop",
  "manifestId": "tabletop-page-safety",
  "description": "Keep chat state alive through posture changes, then prove Settings, Machines, Files, a file preview and Terminal keep their content clear of a fake tabletop hinge in one process.",
  "requires": {
    "page": "chat",
    "fields": [
      "selectedKey",
      "draftHmac",
      "selection.start",
      "selection.end",
      "focused",
      "attachments"
    ]
  },
  "steps": [
    {
      "step": "launch",
      "session": "assistant-chat",
      "conversationKind": "assistant"
    },
    {
      "step": "tap",
      "resource-id": "chat-composer-field"
    },
    {
      "step": "text",
      "text": "tabletop-draft"
    },
    {
      "step": "key",
      "keycombination": [
        "SHIFT_LEFT",
        "ENTER"
      ]
    },
    {
      "step": "text",
      "text": "second-line"
    },
    {
      "step": "key",
      "keycombination": [
        "SHIFT_LEFT",
        "ENTER"
      ]
    },
    {
      "step": "text",
      "text": "third-line"
    },
    {
      "step": "key",
      "keycombination": [
        "SHIFT_LEFT",
        "ENTER"
      ]
    },
    {
      "step": "text",
      "text": "fourth-line"
    },
    {
      "step": "key",
      "keycombination": [
        "CTRL_LEFT",
        "A"
      ]
    },
    {
      "step": "assert",
      "checks": {
        "focused": true,
        "route": {
          "matches": "/chat$"
        }
      }
    },
    {
      "step": "capture",
      "name": "01-flat",
      "state": "flat-assistant"
    },
    {
      "step": "posture",
      "value": 2
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "deviceState": "HALF_OPENED",
        "postureEvidenceType": "folding-feature"
      }
    },
    {
      "step": "capture",
      "name": "02-real-book",
      "state": "real-book-assistant"
    },
    {
      "step": "posture",
      "value": 3
    },
    {
      "step": "rotate",
      "orientation": "landscape"
    },
    {
      "step": "posture",
      "posture": "tabletop",
      "fake": true
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "postureEvidenceType": "fake",
        "window.orientation": "landscape"
      }
    },
    {
      "step": "capture",
      "name": "03-fake-tabletop",
      "state": "fake-tabletop-assistant"
    },
    {
      "step": "wm-size",
      "size": "1000x180",
      "density": 160
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "postureEvidenceType": "fake",
        "window.heightDp": 180
      }
    },
    {
      "step": "capture",
      "name": "04-small-upper",
      "state": "fake-tabletop-small-upper"
    },
    {
      "step": "wm-size",
      "size": "1000x260",
      "density": 160
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "postureEvidenceType": "fake",
        "window.heightDp": 260
      }
    },
    {
      "step": "capture",
      "name": "05-small-lower",
      "state": "fake-tabletop-small-lower"
    },
    {
      "step": "wm-size",
      "reset": true,
      "densityReset": true
    },
    {
      "step": "posture",
      "value": 3,
      "fake": true
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "deviceState": "OPENED"
      }
    },
    {
      "step": "capture",
      "name": "06-flat-restored",
      "state": "flat-assistant-restored"
    },
    {
      "step": "open",
      "page": "settings",
      "probePage": "Settings",
      "posture": "tabletop",
      "fake": true
    },
    {
      "step": "assert",
      "requires": {
        "page": "Settings",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      },
      "checks": {
        "contentBounds": {
          "notOverlaps": "hingeBounds"
        }
      }
    },
    {
      "step": "capture",
      "name": "07-settings",
      "state": "fake-tabletop-settings",
      "requires": {
        "page": "Settings",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      }
    },
    {
      "step": "open",
      "page": "machines",
      "probePage": "Machines",
      "posture": "tabletop",
      "fake": true
    },
    {
      "step": "assert",
      "requires": {
        "page": "Machines",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      },
      "checks": {
        "contentBounds": {
          "notOverlaps": "hingeBounds"
        }
      }
    },
    {
      "step": "capture",
      "name": "08-machines",
      "state": "fake-tabletop-machines",
      "requires": {
        "page": "Machines",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      }
    },
    {
      "step": "open",
      "session": "chat",
      "conversationKind": "agent",
      "posture": "tabletop",
      "fake": true
    },
    {
      "step": "tap",
      "content-desc": "More actions"
    },
    {
      "step": "tap",
      "text": "Files"
    },
    {
      "step": "assert",
      "requires": {
        "page": "weather",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      },
      "checks": {
        "contentBounds": {
          "notOverlaps": "hingeBounds"
        }
      }
    },
    {
      "step": "capture",
      "name": "09-files",
      "state": "fake-tabletop-files",
      "requires": {
        "page": "weather",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      }
    },
    {
      "step": "tap",
      "text": "README.md"
    },
    {
      "step": "assert",
      "requires": {
        "page": "README.md",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      },
      "checks": {
        "contentBounds": {
          "notOverlaps": "hingeBounds"
        }
      }
    },
    {
      "step": "capture",
      "name": "10-file-preview",
      "state": "fake-tabletop-file-preview",
      "requires": {
        "page": "README.md",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      }
    },
    {
      "step": "open",
      "link": "terminal",
      "probePage": "给天气 App 加主屏幕小组件",
      "posture": "tabletop",
      "fake": true
    },
    {
      "step": "assert",
      "requires": {
        "page": "给天气 App 加主屏幕小组件",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      },
      "checks": {
        "contentBounds": {
          "notOverlaps": "hingeBounds"
        }
      }
    },
    {
      "step": "capture",
      "name": "11-terminal",
      "state": "fake-tabletop-terminal",
      "requires": {
        "page": "给天气 App 加主屏幕小组件",
        "fields": [
          "contentBounds",
          "hingeBounds"
        ]
      }
    }
  ]
}
