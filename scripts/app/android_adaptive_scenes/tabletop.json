{
  "id": "tabletop",
  "manifestId": "tabletop-page-safety",
  "description": "Keep one Assistant chat, its multiline draft, selection and focus alive through real book, fake tabletop, constrained safe areas and flat restoration.",
  "requires": {
    "page": "chat",
    "fields": [
      "selectedKey",
      "draftHmac",
      "selection.start",
      "selection.end",
      "focused",
      "attachments"
    ]
  },
  "steps": [
    {
      "step": "launch",
      "session": "assistant-chat",
      "conversationKind": "assistant"
    },
    {
      "step": "tap",
      "resource-id": "chat-composer-field"
    },
    {
      "step": "text",
      "text": "tabletop-draft"
    },
    {
      "step": "key",
      "keycombination": ["SHIFT_LEFT", "ENTER"]
    },
    {
      "step": "text",
      "text": "second-line"
    },
    {
      "step": "key",
      "keycombination": ["SHIFT_LEFT", "ENTER"]
    },
    {
      "step": "text",
      "text": "third-line"
    },
    {
      "step": "key",
      "keycombination": ["SHIFT_LEFT", "ENTER"]
    },
    {
      "step": "text",
      "text": "fourth-line"
    },
    {
      "step": "key",
      "keycombination": ["CTRL_LEFT", "A"]
    },
    {
      "step": "assert",
      "checks": {
        "focused": true,
        "route": {"matches": "/chat$"}
      }
    },
    {
      "step": "capture",
      "name": "01-flat",
      "state": "flat-assistant"
    },
    {
      "step": "posture",
      "value": 2
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "deviceState": "HALF_OPENED",
        "postureEvidenceType": "folding-feature"
      }
    },
    {
      "step": "capture",
      "name": "02-real-book",
      "state": "real-book-assistant"
    },
    {
      "step": "posture",
      "value": 3
    },
    {
      "step": "rotate",
      "orientation": "landscape"
    },
    {
      "step": "posture",
      "posture": "tabletop",
      "fake": true
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "postureEvidenceType": "fake",
        "window.orientation": "landscape"
      }
    },
    {
      "step": "capture",
      "name": "03-fake-tabletop",
      "state": "fake-tabletop-assistant"
    },
    {
      "step": "wm-size",
      "size": "1000x180",
      "density": 160
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "postureEvidenceType": "fake",
        "window.heightDp": 180
      }
    },
    {
      "step": "capture",
      "name": "04-small-upper",
      "state": "fake-tabletop-small-upper"
    },
    {
      "step": "wm-size",
      "size": "1000x260",
      "density": 160
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "postureEvidenceType": "fake",
        "window.heightDp": 260
      }
    },
    {
      "step": "capture",
      "name": "05-small-lower",
      "state": "fake-tabletop-small-lower"
    },
    {
      "step": "wm-size",
      "reset": true,
      "densityReset": true
    },
    {
      "step": "posture",
      "value": 3,
      "fake": true
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": "unchanged",
        "selectedKey": "unchanged",
        "draftHmac": "unchanged",
        "selection": "unchanged",
        "focused": true,
        "attachments": "unchanged",
        "deviceState": "OPENED"
      }
    },
    {
      "step": "capture",
      "name": "06-flat-restored",
      "state": "flat-assistant-restored"
    }
  ]
}
