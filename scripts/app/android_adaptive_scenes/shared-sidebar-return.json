{
  "id": "shared-sidebar-return",
  "manifestId": "android-large-window-shared-sidebar-return",
  "description": "Open an Inbox item beside the shared Assistant sidebar, rotate and resize the window in one process, then Back to the Inbox list with the sidebar still in place. The Inbox shows its item in the page itself, so the stack route stays inbox and the item is checked on the screenshots.",
  "requires": {
    "stackProbe": true,
    "fields": [
      "pid",
      "route",
      "selectedKey"
    ]
  },
  "steps": [
    {
      "step": "launch",
      "page": "inbox",
      "probePage": "Inbox"
    },
    {
      "step": "assert",
      "requires": {
        "page": "Inbox",
        "fields": [
          "firstVisibleKey",
          "firstVisibleOffsetPx"
        ]
      },
      "checks": {
        "route": {
          "equals": "inbox"
        },
        "selectedKey": {
          "equals": null
        }
      }
    },
    {
      "step": "capture",
      "name": "01-sidebar-inbox-list"
    },
    {
      "step": "tap",
      "text": "Plan awaiting approval"
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        }
      }
    },
    {
      "step": "capture",
      "name": "02-sidebar-detail-right-stack"
    },
    {
      "step": "rotate",
      "orientation": "portrait"
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        },
        "window.orientation": {
          "equals": "portrait"
        }
      }
    },
    {
      "step": "capture",
      "name": "03-detail-rotated-portrait"
    },
    {
      "step": "wm-size",
      "size": "900x1200",
      "density": 160,
      "widthDp": 900,
      "heightDp": 1200
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        },
        "window.widthDp": {
          "equals": 900
        }
      }
    },
    {
      "step": "capture",
      "name": "06-detail-regular-portrait-again"
    },
    {
      "step": "key",
      "keycombination": [
        "BACK"
      ]
    },
    {
      "step": "assert",
      "requires": {
        "page": "Inbox",
        "fields": [
          "firstVisibleKey",
          "firstVisibleOffsetPx"
        ]
      },
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        },
        "selectedKey": {
          "equals": null
        }
      }
    },
    {
      "step": "capture",
      "name": "07-back-restored-inbox-list"
    }
  ]
}
