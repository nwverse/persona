{
  "schema_version": 1,
  "id": "example",
  "revision": "r1",
  "title": "Example settings",
  "description": "A synthetic document with every kind of field, for tests and screenshots only.",
  "groups": [
    {
      "id": "basics",
      "title": "Basics",
      "description": "Switches and text.",
      "fields": [
        { "id": "enabled", "kind": "toggle", "title": "Enable the example", "description": "Turns the example on.", "default": false },
        { "id": "nickname", "kind": "text", "title": "Nickname", "description": "Shown beside your name.", "default": "", "text": { "placeholder": "e.g. Sam", "max_length": 20 } },
        { "id": "note", "kind": "text", "title": "Note", "default": "Hello, 世界 👋", "text": { "multiline": true, "min_length": 1, "max_length": 200 } },
        { "id": "locked", "kind": "toggle", "title": "Managed by your organization", "default": true, "read_only": true },
        { "id": "paused", "kind": "toggle", "title": "Paused option", "default": false, "disabled_reason": "Available once the example is set up." }
      ]
    },
    {
      "id": "choices",
      "title": "Choices",
      "fields": [
        { "id": "mode", "kind": "select", "title": "Mode", "description": "How the example runs.", "default": "auto", "select": { "presentation": "list", "options": [ { "value": "auto", "title": "Automatic", "description": "Picks for you." }, { "value": "manual", "title": "Manual", "description": "You decide each time." } ] } },
        { "id": "size", "kind": "select", "title": "Size", "default": "m", "select": { "presentation": "segmented", "options": [ { "value": "s", "title": "Small" }, { "value": "m", "title": "Medium" }, { "value": "l", "title": "Large" } ] } },
        { "id": "region", "kind": "select", "title": "Region", "default": "eu", "select": { "presentation": "dropdown", "options": [ { "value": "eu", "title": "Europe" }, { "value": "us", "title": "United States" }, { "value": "ap", "title": "Asia Pacific" } ] } },
        { "id": "days", "kind": "multiselect", "title": "Days", "description": "When the example may run.", "default": ["mon", "wed"], "multiselect": { "min_selected": 1, "max_selected": 3, "options": [ { "value": "mon", "title": "Monday" }, { "value": "wed", "title": "Wednesday" }, { "value": "fri", "title": "Friday" }, { "value": "sun", "title": "Sunday", "description": "Only if you're around." } ] } },
        { "id": "limit", "kind": "number", "title": "Daily limit", "default": 10, "number": { "integer": true, "minimum": 1, "maximum": 100, "step": 5 }, "details": [ { "title": "Takes effect", "description": "From the next run." } ] },
        { "id": "ratio", "kind": "number", "title": "Ratio", "default": 0.5, "number": { "minimum": 0.25, "maximum": 1.75, "step": 0.25 } },
        { "id": "future", "kind": "color", "title": "Accent from a newer version", "description": "A kind this client doesn't know.", "default": "#ff0000" }
      ]
    }
  ],
  "values": {
    "enabled": true,
    "nickname": "",
    "note": "Hello, 世界 👋",
    "locked": true,
    "paused": false,
    "mode": "manual",
    "size": "m",
    "region": "eu",
    "days": ["mon", "wed"],
    "limit": 25,
    "ratio": 0.5,
    "future": "#00ff00"
  },
  "notices": { "mode": { "kind": "info", "message": "Manual mode asks before each run." } }
}
