<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Persona Screen: the iOS live-screen video helper (#3954), an app bundle inside Persona Link.app/Contents/Helpers/
     so its Screen Recording grant is its own, not the node's. mac-link.sh substitutes __SCREEN_BUNDLE_ID__ (the Link
     bundle id + ".screen") when it embeds the bundle. Nothing here changes from build to build (no timestamp): an
     unchanged helper then keeps its ad-hoc signature, and with it its Screen Recording grant, across Persona Link
     updates. LSUIElement keeps it off the Dock. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleIdentifier</key>
	<string>__SCREEN_BUNDLE_ID__</string>
	<key>CFBundleName</key>
	<string>Persona Screen</string>
	<key>CFBundleDisplayName</key>
	<string>Persona Screen</string>
	<key>CFBundleExecutable</key>
	<string>PersonaScreen</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Persona</string>
</dict>
</plist>
