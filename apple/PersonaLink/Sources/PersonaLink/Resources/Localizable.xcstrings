    "The SSH server (%@) refused authentication; check your key, ssh-agent, or ~/.ssh/config." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SSH server (%1$@) refused authentication; check your key, ssh-agent, or ~/.ssh/config."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH サーバー（%1$@）に認証を拒否されたため、公開鍵・ssh-agent・~/.ssh/config を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器（%1$@）拒绝了登录认证，请检查公钥、ssh-agent 或 ~/.ssh/config。"
          }
        }
      }
    },
    "The SSH server refused port forwarding to %@; check AllowTcpForwarding and permitopen on the server." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SSH server refused port forwarding to %1$@; check AllowTcpForwarding and permitopen on the server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH サーバーに %1$@ へのポート転送を拒否されたため、サーバー側の AllowTcpForwarding と permitopen を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器拒绝转发到 %1$@，请检查服务器上的 AllowTcpForwarding 和 authorized_keys 里的 permitopen。"
          }
        }
      }
    },
    "The hub isn't answering at %@ through the SSH server; check that the hub is running and the target port is right." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub isn't answering at %1$@ through the SSH server; check that the hub is running and the target port is right."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 経由で %1$@ のハブから応答がないため、ハブが動いているかと宛先ポートが正しいかを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经 SSH 连不上 %1$@ 上的 hub，请检查 hub 在不在运行、目标端口对不对。"
          }
        }
      }
    },
    "There is no ssh command on this computer; install an OpenSSH client first." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no ssh command on this computer; install an OpenSSH client first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンピューターには ssh コマンドがないため、先に OpenSSH クライアントをインストールしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑上没有 ssh 命令，先安装 OpenSSH 客户端。"
          }
        }
      }
    },
    "This SSH server's host key isn't trusted yet; run “%@” once in a terminal to check and accept it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This SSH server's host key isn't trusted yet; run “%1$@” once in a terminal to check and accept it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この SSH サーバーのホスト鍵がまだ信頼されていないため、先にターミナルで一度「%1$@」を実行して確認・承認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还不信任这台 SSH 服务器的主机密钥，先在终端里运行一次 %1$@ 确认并接受它。"
          }
        }
      }
    },
    "When off, direct hub addresses are tried first and SSH is used only if they fail." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, direct hub addresses are tried first and SSH is used only if they fail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフのときは先に直接接続を試し、届かないときだけ SSH を使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时先试直连地址，都连不上再走 SSH。"
          }
        }
      }
    },
