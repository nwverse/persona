          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブ%1$@%2$@とペアリング済みです。新しいリンクを作って別のハブとペアリングすると、元のハブからは接続できなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
