    "“Needs you” rows and notifications open the web app here. Leave it empty to use %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Needs you” rows and notifications open the web app here. Leave it empty to use %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「要対応」の項目と通知は、このアドレスでWebアプリを開きます。空欄なら%1$@を使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「需要你」里的会话和通知在这个地址打开网页。留空就用 %1$@。"
          }
        }
      }
    },
    "“Needs you” rows and notifications open the web app here. The hub does not say where it is." : {
