    "The hub does not say where its web app is: set its web address to open these." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub does not say where its web app is: set its web address to open these."
