<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget, the Quick Settings tile and the launcher shortcuts' dialog (docs/android/android.md "Ongoing notification and home-screen entries"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="persona.platform.shortcuts.PersonaWidgetReceiver"
            android:exported="true"
            android:label="@string/shortcuts_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/persona_widget_info" />
        </receiver>
        <service
            android:name="persona.platform.shortcuts.PersonaTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="@string/shortcuts_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>
        <!-- Not exported: only the launcher's own shortcut, started on the app's behalf, reaches it. -->
        <activity
            android:name="persona.platform.shortcuts.ApproveFirstActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Persona.Shortcut" />
    </application>
</manifest>
