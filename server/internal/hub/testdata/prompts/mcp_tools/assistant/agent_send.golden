{
  "name": "agent_send",
  "description": "Send requested work; task required unless on your open task. Busy Agents may queue; nearly full ones compact. Stops need resume+resume_why: recorded non-user stops, including quota/capacity, allow it; user/exit/unknown stops need the user's Resume. Unrelated work: agent_start; unsure: ask_user. A branch starts on its first message. Only /exit or /quit stops a running Agent and keeps its tab; other conversations' Agents need their owner's controls.\n\ndialog_open: dismiss_notice only for Enter-only notices; permissions/pickers need the user or interaction_answer.\n\ntask: supervise new work; include done_when in text. Keeps existing work's title, updates criteria; refuses different titles or user/others' tasks. Failed sends create no task. Omit for replies/nudges/decisions.\n\ncontinuation: only failed task_plan's exact plan_id/task_index action, original session/scope; omit task/handoff. Retains start failure; no duplicate/uncertain replay. Read Agent to verify execution.\n\nhandoff: already-stopped task you supervise; node ACK starts waiting for receiver's result.\n\nwait_seconds: observe up to 50s; Inline observation JSON: completed(reply to this input), question(interaction_id), timeout/cancelled/unavailable/interrupted/failed, known input/session ids. Never answers, accepts, resends or cancels; normal task_review/supervision applies. Older nodes may time out, never returning unrelated replies.",
  "input_schema": {
    "type": "object",
    "required": [
      "machine",
      "session_id",
      "text"
    ],
    "properties": {
      "wait_seconds": {
        "type": "integer",
        "minimum": 0,
        "description": "0/omitted: normal receipt"
      },
      "machine": {
        "type": "string"
      },
      "session_id": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "resume": {
        "type": "boolean",
        "description": "resume this stopped agent with its context, text as its first message"
      },
      "resume_why": {
        "type": "string",
        "description": "shown to the user"
      },
      "dismiss_notice": {
        "type": "boolean",
        "description": "Press Enter first to close a notice that only says \"Enter to continue\" (no options). Any other dialog still refuses the send."
      },
      "attachments": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        },
        "description": "absolute paths of pictures/files the user gave in this conversation (Claude Code path or app attachment); copied to the agent, appended to its message with mentions updated; others refused"
      },
      "continuation": {
        "type": "object",
        "required": [
          "plan_id",
          "task_index"
        ],
        "additionalProperties": false,
        "properties": {
          "plan_id": {
            "type": "string"
          },
          "task_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "handoff": {
        "type": "object",
        "required": [
          "todo_id",
          "receiving_todo_id",
          "head",
          "check",
          "until"
        ],
        "additionalProperties": false,
        "properties": {
          "todo_id": {
            "type": "string"
          },
          "receiving_todo_id": {
            "type": "string"
          },
          "head": {
            "type": "string",
            "description": "Full candidate commit ID"
          },
          "check": {
            "type": "string"
          },
          "until": {
            "type": "string",
            "description": "Duration or RFC 3339 deadline"
          }
        }
      },
      "task": {
        "type": [
          "object",
          "null"
        ],
        "description": "new work: make it your supervised task first (main or a lead); null for a reply",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "the task in a short line (Chinese, under 20 characters)"
          },
          "done_when": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            },
            "description": "results you can check when it says it is done (a PR merged, a sheet's link, what the live system answers)"
          },
          "expect_minutes": {
            "type": "integer",
            "description": "how long it should take from now; longer without progress counts as stuck"
          }
        }
      }
    }
  }
}
