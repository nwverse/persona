{
  "name": "watch_reorder",
  "description": "Reorder Overview's watch cards: ids first; the rest follow in their order.",
  "input_schema": {
    "type": "object",
    "required": [
      "ids"
    ],
    "properties": {
      "ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
