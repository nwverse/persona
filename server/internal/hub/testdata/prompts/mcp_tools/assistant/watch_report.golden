{
  "name": "watch_report",
  "description": "Record a watch run's result, as its run message says.",
  "input_schema": {
    "type": "object",
    "required": [
      "id",
      "text"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "number": {
        "type": "number"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "warn",
          "bad"
        ]
      },
      "text": {
        "type": "string"
      },
      "table": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
