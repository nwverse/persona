{
  "name": "kb_get",
  "description": "Read one entity: metadata (links, tags), compressed context (summary.md), a project's timeline, parent, sub-projects and milestones, a chat's last 7 days of messages, a recording's minutes or an all-day recording's recap (timeline, meetings, suggested to-dos) with each action item's state and, while retained, its timestamped transcript (text only), a meeting's / event's recordings, a topic's points by subtopic (kind, reason, source entries). Transcripts expire after recording_days (default 14); minutes and recaps stay for minutes_days (default forever). id from kb_list / kb_search (a project also by name). A project lists its 20 most relevant people and a count (all: meta.json).",
  "input_schema": {
    "type": "object",
    "required": [
      "kind",
      "id"
    ],
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "projects",
          "chats",
          "people",
          "docs",
          "meetings",
          "events",
          "recordings",
          "topics"
        ]
      },
      "id": {
        "type": "string"
      }
    }
  }
}
