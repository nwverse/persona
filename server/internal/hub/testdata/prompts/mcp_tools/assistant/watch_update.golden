{
  "name": "watch_update",
  "description": "Change a watch card: `id` plus the watch_draft fields to change; `paused` stops or resumes it.",
  "input_schema": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "paused": {
        "type": "boolean"
      }
    }
  }
}
