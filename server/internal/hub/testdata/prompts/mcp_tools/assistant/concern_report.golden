{
  "name": "concern_report",
  "description": "Report the outcome of a user's concern (todo_list kind concern) and close it: main conversation only. Call it in the same reply in which you tell the user the outcome, with report the words you told them, faithfully; it is kept on the concern as a decision of source reported (shown in the app, sent to extensions). It is the only way a concern closes: nothing closes one on its own, and todo_complete refuses it. Report only an outcome the user was actually told; an unsettled concern stays open. A concern the user reopens needs another report.",
  "input_schema": {
    "type": "object",
    "required": [
      "id",
      "report"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Concern id from todo_list."
      },
      "report": {
        "type": "string",
        "description": "what you told the user of its outcome, as you said it in this reply (at most 4000 characters)"
      }
    }
  }
}
