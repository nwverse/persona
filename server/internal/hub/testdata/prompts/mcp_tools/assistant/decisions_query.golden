{
  "name": "decisions_query",
  "description": "List decisions with after paging. Scope filters executor, machine[], project[] and personal.",
  "input_schema": {
    "type": "object",
    "properties": {
      "after": {
        "type": "string"
      },
      "limit": {
        "type": "integer"
      },
      "by": {
        "type": "string"
      },
      "trust": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "tag": {
        "type": "string"
      },
      "scope": {
        "type": "object"
      }
    },
    "additionalProperties": false
  }
}
