{
  "name": "schedule_followup",
  "description": "Wake yourself later with `prompt`; `new_conversation: true` uses its own chat. Wakes reset the message hop chain at most once per 10 minutes. `at` accepts RFC3339 or relative 30m/2h/1d. For repeats set `every` (5m-7d) once; never chain runs. Or `cron` instead of at/every (5 fields in the user's zone, at least 5m apart, 0/7 = Sunday, restricted day fields match either; check the reply's next runs). `until` cannot be a bare clock time.\n\nRuns inherit Main chat's launcher/model/effort; overrides need an own conversation; permission mode stays the user's. `fresh_each_run: true` starts a new chat each run with its state note.\n\nFor approved recurring work advancing a supervised to-do, pass its explicit `todo_id`, never guessed from a title (omit keeps, \"\" clears, one-shots refuse it). From the second run progress is new Agent answers or tool calls (not waits or repeats), criterion changes or reports; a long stall asks Change approach / Keep waiting, even with `push: asked`. Get owner consent before creating or changing recurring work.",
  "input_schema": {
    "type": "object",
    "required": [
      "prompt"
    ],
    "properties": {
      "todo_id": {
        "type": "string",
        "description": "explicit supervised to-do this recurring follow-up advances"
      },
      "fresh_each_run": {
        "type": "boolean"
      },
      "at": {
        "type": "string",
        "description": "when (the first run, with every); default with every: one interval from now"
      },
      "every": {
        "type": "string",
        "description": "repeat this often, e.g. 30m"
      },
      "cron": {
        "type": "string",
        "description": "repeat on a cron expression instead of at / every: minute hour day-of-month month day-of-week in the user's time zone, e.g. */30 9-18 * * 1-5"
      },
      "prompt": {
        "type": "string",
        "description": "what to do then, self-contained"
      },
      "title": {
        "type": "string",
        "description": "short label shown in the app"
      },
      "new_conversation": {
        "type": "boolean",
        "description": "start a fresh conversation instead of continuing this one"
      },
      "push": {
        "type": "string",
        "enum": [
          "every",
          "asked"
        ],
        "description": "every (default): each run's answer is pushed; asked: only what a run sends with notify_user, for watching something or a standing loop (patrol, daily round). Continuing this conversation, answers are then not pushed or sent to channels; from Main chat it runs in its own conversation. Omit to keep"
      },
      "inbox": {
        "type": "string",
        "enum": [
          "off",
          "worthy",
          "every"
        ],
        "description": "Inbox rows, independent of push: off (default), worthy (the run uses inbox_post only for something worth a look), every (Persona adds a row after each run). Only when the user asked. Omit to keep"
      },
      "until": {
        "type": [
          "string",
          "null"
        ],
        "description": "optional end time (RFC 3339 or 30m / 2h / 1d); then Persona turns it off and records a skipped run. Omit keeps; null clears; ignored for a one-off"
      },
      "launcher": {
        "type": "string",
        "description": "own launcher instead of Main chat's (a name on the run's computer); needs new_conversation: true, since continuing this conversation keeps its launcher. Empty follows Main chat. Omit to keep"
      },
      "model": {
        "type": "string",
        "description": "model id for that launcher (without one, pins the current launcher); empty: its default. Omit to keep"
      },
      "effort": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "description": "Claude thinking effort (without a launcher, pins the current one). Omit keeps; empty clears"
      }
    }
  }
}
