{
  "name": "todo_update",
  "description": "Edit supplied fields. \"\" clears notes/due/remind/project/part_of/audience. [] clears after. Use todo_complete or todo_reopen. outward_reply records the sent reply's HTTPS topic, permalink, exact text and RFC3339 provider time. Retry recording only. promise overrides detection and due_at overrides 24h.",
  "input_schema": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "notes": {
        "type": "string",
        "description": "Keep needed notes."
      },
      "due": {
        "type": "string",
        "description": "YYYY-MM-DD or RFC3339."
      },
      "remind": {
        "type": "string",
        "description": "Future time or 30m/2h/1d. Notifies again."
      },
      "priority": {
        "type": "string",
        "enum": [
          "high",
          "normal",
          "low"
        ]
      },
      "project": {
        "type": "string",
        "description": "Existing KB project slug/name."
      },
      "audience": {
        "type": "string",
        "description": "human, autonomous, or \"\" to clear."
      },
      "part_of": {
        "type": "string",
        "description": "Request id; changing clears after."
      },
      "after": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Sibling piece ids."
      },
      "outward_reply": {
        "type": "object",
        "required": [
          "topic_url",
          "sent_url",
          "text",
          "sent_at"
        ],
        "properties": {
          "topic_url": {
            "type": "string"
          },
          "sent_url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sent_at": {
            "type": "string"
          },
          "due_at": {
            "type": "string"
          },
          "promise": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
