{
  "name": "todo_update",
  "description": "Set supplied fields now; no prompt. \"\" clears notes/due/remind/project/part_of/audience/direction_id; [] clears after. Use todo_complete/todo_reopen. outward_reply records only: HTTPS source topic, sent permalink, exact text, RFC3339 time. Retry recording only. promise overrides detection; due_at defaults 24h.",
  "input_schema": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "notes": {
        "type": "string",
        "description": "Keep needed text."
      },
      "due": {
        "type": "string",
        "description": "Date or local/RFC3339."
      },
      "remind": {
        "type": "string",
        "description": "Future time or 30m/2h/1d; renotifies."
      },
      "priority": {
        "type": "string",
        "enum": [
          "high",
          "normal",
          "low"
        ]
      },
      "project": {
        "type": "string",
        "description": "Existing KB slug/name; no dupes."
      },
      "audience": {
        "type": "string",
        "description": "human/autonomous."
      },
      "direction_id": {
        "type": "string"
      },
      "part_of": {
        "type": "string",
        "description": "Request ID; change clears after."
      },
      "after": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Sibling IDs."
      },
      "outward_reply": {
        "type": "object",
        "required": [
          "topic_url",
          "sent_url",
          "text",
          "sent_at"
        ],
        "properties": {
          "topic_url": {
            "type": "string"
          },
          "sent_url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sent_at": {
            "type": "string"
          },
          "due_at": {
            "type": "string"
          },
          "promise": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
