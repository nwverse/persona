{
  "name": "todo_update",
  "description": "Apply only supplied fields now; no confirmation. \"\" clears notes/due/remind/project/part_of/audience/direction_id; [] clears after. Use todo_complete/todo_reopen. outward_reply only records sent replies: original HTTPS topic, permalink, verbatim text, RFC3339 provider time. Retry recording only. promise overrides detection; due_at overrides 24h.",
  "input_schema": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "notes": {
        "type": "string",
        "description": "Replace; keep needed text."
      },
      "due": {
        "type": "string",
        "description": "YYYY-MM-DD, local or RFC3339."
      },
      "remind": {
        "type": "string",
        "description": "Future local/RFC3339 or 30m/2h/1d. Renotifies."
      },
      "priority": {
        "type": "string",
        "enum": [
          "high",
          "normal",
          "low"
        ]
      },
      "project": {
        "type": "string",
        "description": "Existing KB project slug/name; no duplicates."
      },
      "audience": {
        "type": "string",
        "description": "human or autonomous."
      },
      "direction_id": {
        "type": "string",
        "description": "Direction ID."
      },
      "part_of": {
        "type": "string",
        "description": "Request id; changing clears after."
      },
      "after": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Replace sibling piece IDs."
      },
      "outward_reply": {
        "type": "object",
        "required": [
          "topic_url",
          "sent_url",
          "text",
          "sent_at"
        ],
        "properties": {
          "topic_url": {
            "type": "string"
          },
          "sent_url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sent_at": {
            "type": "string"
          },
          "due_at": {
            "type": "string"
          },
          "promise": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
